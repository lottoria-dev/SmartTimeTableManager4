<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- All large surfaces are opaque. Small highlights are painted over these surfaces, never over the desktop. -->
 <SolidColorBrush x:Key="AquaNeutral" Color="#E6E8EC"/>
 <SolidColorBrush x:Key="AquaNeutralEdge" Color="#ADB3BC"/>
 <SolidColorBrush x:Key="AquaInk" Color="#24384F"/>
 <SolidColorBrush x:Key="AquaMuted" Color="#53667C"/>
 <SolidColorBrush x:Key="AquaEdge" Color="#A9BCD0"/>
 <SolidColorBrush x:Key="AquaFocus" Color="#367EB8"/>
 <SolidColorBrush x:Key="AquaBlue" Color="#D6E7FA"/>
 <SolidColorBrush x:Key="AquaBlueStrong" Color="#92C0EE"/>
 <SolidColorBrush x:Key="AquaMint" Color="#D5EEDF"/>
 <SolidColorBrush x:Key="AquaMintStrong" Color="#A1D9BB"/>
 <SolidColorBrush x:Key="AquaCyan" Color="#D4EEF1"/>
 <SolidColorBrush x:Key="AquaCyanStrong" Color="#9FD4DE"/>
 <SolidColorBrush x:Key="AquaLavender" Color="#E5DFF5"/>
 <SolidColorBrush x:Key="AquaLavenderStrong" Color="#C4B4E9"/>
 <SolidColorBrush x:Key="AquaPeach" Color="#F5E6DC"/>
 <LinearGradientBrush x:Key="AquaWindow" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#F3F7FC" Offset="0"/><GradientStop Color="#E3EBF5" Offset="0.48"/><GradientStop Color="#EDF2F8" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="AquaGlass" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F3F7FC" Offset="0.45"/><GradientStop Color="#E4EDF7" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="AquaMenuSurface" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#FBFCFF" Offset="0"/><GradientStop Color="#E8EEF8" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="AquaShine" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#CFFFFFFF" Offset="0"/><GradientStop Color="#65FFFFFF" Offset="0.48"/>
  <GradientStop Color="#00FFFFFF" Offset="0.51"/><GradientStop Color="#28FFFFFF" Offset="1"/>
 </LinearGradientBrush>
 <Style TargetType="Window">
  <Setter Property="Icon" Value="pack://application:,,,/Assets/TimeTableManager4.ico"/>
  <Setter Property="FontFamily" Value="Malgun Gothic"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="{StaticResource AquaInk}"/><Setter Property="Background" Value="{StaticResource AquaWindow}"/>
  <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
 </Style>
 <Style x:Key="AquaButton" TargetType="Button">
  <Setter Property="Background" Value="{StaticResource AquaNeutral}"/><Setter Property="Foreground" Value="{StaticResource AquaInk}"/>
  <Setter Property="BorderBrush" Value="{StaticResource AquaNeutralEdge}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="9,2"/><Setter Property="Margin" Value="0,0,5,4"/>
  <Setter Property="MinHeight" Value="26"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid SnapsToDevicePixels="True">
    <Border Background="#C4C8CE" CornerRadius="12" Margin="0,2,0,0"/>
    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Margin="0,0,0,1">
     <Grid>
      <Border x:Name="Shine" Background="{StaticResource AquaShine}" BorderBrush="#BFFFFFFF" BorderThickness="1" CornerRadius="11"/>
      <Border x:Name="Hover" Background="#30FFFFFF" CornerRadius="11" Visibility="Collapsed"/>
      <Border x:Name="Pressed" Background="#180F2D4B" CornerRadius="11" Visibility="Collapsed"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
     </Grid>
    </Border>
    <Border x:Name="FocusRing" BorderBrush="#367EB8" BorderThickness="2" CornerRadius="12" IsHitTestVisible="False" Visibility="Collapsed"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Visibility" Value="Visible"/><Setter TargetName="Shell" Property="BorderBrush" Value="#5F8DBA"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource AquaBlue}"/><Setter TargetName="Pressed" Property="Visibility" Value="Visible"/><Setter TargetName="Shine" Property="Opacity" Value="0.35"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsDefaulted" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#4E86BC"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Background" Value="#E7ECF2"/><Setter Property="Foreground" Value="#768294"/><Setter TargetName="Shine" Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Button" BasedOn="{StaticResource AquaButton}"/>
 <Style x:Key="AquaComboBox" TargetType="ComboBox">
  <Setter Property="Background" Value="{StaticResource AquaLavender}"/><Setter Property="Foreground" Value="{StaticResource AquaInk}"/>
  <Setter Property="BorderBrush" Value="{StaticResource AquaEdge}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="26"/><Setter Property="Margin" Value="0,3,0,7"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
  <Setter Property="MaxDropDownHeight" Value="360"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid>
    <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press"
     IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
     Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="ToggleShell" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
       <Grid><Border Background="{StaticResource AquaShine}" CornerRadius="7" Margin="1"/>
        <Border HorizontalAlignment="Right" Width="18" Background="#24FFFFFF" CornerRadius="0,7,7,0" BorderBrush="#7595B4" BorderThickness="1,0,0,0">
         <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#375B7D" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleShell" Property="BorderBrush" Value="#5F8DBA"/></Trigger>
       <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleShell" Property="Background" Value="{StaticResource AquaBlueStrong}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="Selection" IsHitTestVisible="False" Margin="7,1,23,1" VerticalAlignment="Center"
     Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
    <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}" Margin="5,1,22,1" Padding="2,0" BorderThickness="0" Background="#FAFCFF" VerticalContentAlignment="Center"/>
    <Border x:Name="ComboFocus" IsHitTestVisible="False" CornerRadius="8" BorderBrush="#367EB8" BorderThickness="2" Visibility="Collapsed"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
     IsOpen="{TemplateBinding IsDropDownOpen}">
     <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
      Background="{StaticResource AquaMenuSurface}" BorderBrush="{StaticResource AquaEdge}" BorderThickness="1" CornerRadius="8" Padding="3">
      <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
       <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
      </ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="Selection" Property="Visibility" Value="Hidden"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#768294"/><Setter TargetName="DropToggle" Property="Background" Value="#E7ECF2"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource AquaComboBox}"/>
 <Style TargetType="ComboBoxItem">
  <Setter Property="Padding" Value="7,3"/><Setter Property="MinHeight" Value="24"/>
  <Setter Property="Foreground" Value="{StaticResource AquaInk}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
   <Border x:Name="ItemShell" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="{StaticResource AquaLavender}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="{StaticResource AquaBlue}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#768294"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AquaTextBox" TargetType="TextBox">
  <Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="MinHeight" Value="28"/>
  <Setter Property="Foreground" Value="{StaticResource AquaInk}"/><Setter Property="Background" Value="#FBFCFF"/>
  <Setter Property="BorderBrush" Value="{StaticResource AquaEdge}"/>
  <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#367EB8"/></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource AquaTextBox}"/>
 <Style TargetType="Menu"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource AquaInk}"/></Style>
 <Style TargetType="MenuItem">
  <Setter Property="Padding" Value="9,5"/><Setter Property="Foreground" Value="{StaticResource AquaInk}"/>
  <Setter Property="Background" Value="{StaticResource AquaMenuSurface}"/>
  <Style.Triggers>
   <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Background" Value="Transparent"/></Trigger>
   <Trigger Property="Role" Value="TopLevelItem"><Setter Property="Background" Value="Transparent"/></Trigger>
   <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource AquaBlue}"/></Trigger>
   <Trigger Property="IsSubmenuOpen" Value="True"><Setter Property="Background" Value="{StaticResource AquaLavender}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#768294"/></Trigger>
  </Style.Triggers>
 </Style>
 <!-- Right-click menus have no reserved icon gutter. Only real icons/checks occupy space.
      ItemContainerStyle is passed down so all submenu levels use the same template. -->
 <Style x:Key="AquaContextSeparator" TargetType="Separator">
  <Setter Property="Margin" Value="6,3"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
   <Border Height="1" Background="{StaticResource AquaEdge}" SnapsToDevicePixels="True"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AquaContextMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
  <Style.Resources><Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource AquaContextSeparator}"/></Style.Resources>
  <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8,5"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="ItemContainerStyle" Value="{DynamicResource AquaContextMenuItem}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Grid SnapsToDevicePixels="True">
    <Border x:Name="ItemShell" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentPresenter x:Name="IconHost" Content="{TemplateBinding Icon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
      <Border x:Name="CheckHost" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"
       Background="#FBFCFF" BorderBrush="{StaticResource AquaEdge}" BorderThickness="1" CornerRadius="2">
       <Path x:Name="CheckMark" Data="M 0 3 L 3 6 L 9 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
        Width="9" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Border>
      <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      <TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
      <Path x:Name="SubmenuArrow" Grid.Column="3" Data="M 0 0 L 4 4 L 0 8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
       Width="5" Height="9" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-1" VerticalOffset="-3" AllowsTransparency="True"
     Focusable="False" PopupAnimation="None" IsOpen="{TemplateBinding IsSubmenuOpen}"
     PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
     <Border Background="{StaticResource AquaMenuSurface}" BorderBrush="{StaticResource AquaEdge}" BorderThickness="1" CornerRadius="5" Padding="3">
      <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
       <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="IsCheckable" Value="True"><Setter TargetName="CheckHost" Property="Visibility" Value="Visible"/><Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="InputGestureText" Value=""><Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="InputGestureText" Value="{x:Null}"><Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="HasItems" Value="True"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ContextMenu">
  <Style.Resources><Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource AquaContextSeparator}"/></Style.Resources>
  <Setter Property="Background" Value="{StaticResource AquaMenuSurface}"/><Setter Property="Foreground" Value="{StaticResource AquaInk}"/>
  <Setter Property="BorderBrush" Value="{StaticResource AquaEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="3"/>
  <Setter Property="ItemContainerStyle" Value="{StaticResource AquaContextMenuItem}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
    CornerRadius="5" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
     <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"/>
    </ScrollViewer>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="#F8FBFF"/><Setter Property="Foreground" Value="{StaticResource AquaInk}"/><Setter Property="BorderBrush" Value="{StaticResource AquaEdge}"/><Setter Property="Padding" Value="10,7"/></Style>
 <Style x:Key="ModeTabs" TargetType="TabControl">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <Grid>
    <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource AquaEdge}"/>
    <!-- StackPanel preserves each tag's top margin; TabPanel's row arrangement can clip the passive border. -->
    <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" HorizontalAlignment="Left" Margin="0,0,14,1" ClipToBounds="False" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Visibility="Collapsed"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ModeTab" TargetType="TabItem">
  <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,4,26,4"/><Setter Property="Margin" Value="0,4,-14,0"/>
  <Setter Property="MinWidth" Value="96"/><Setter Property="VerticalAlignment" Value="Bottom"/>
  <Setter Property="Foreground" Value="{StaticResource AquaInk}"/><Setter Property="Background" Value="#E8EDF2"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="TabShell" Background="{TemplateBinding Background}" BorderBrush="{StaticResource AquaEdge}" BorderThickness="1" CornerRadius="6,6,0,0" SnapsToDevicePixels="True">
    <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter TargetName="TabShell" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
     <Setter TargetName="TabShell" Property="BorderThickness" Value="1,1,1,0"/>
     <Setter Property="Margin" Value="0,0,-14,-1"/><Setter Property="Padding" Value="12,6,26,6"/>
     <Setter Property="Panel.ZIndex" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabShell" Property="BorderBrush" Value="#5F8DBA"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#174D7A"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#768294"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="DataGrid">
  <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
  <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
  <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E0E7F0"/>
  <Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F7FAFE"/>
  <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinRowHeight" Value="36"/>
  <Setter Property="Background" Value="#F0F4F9"/><Setter Property="Foreground" Value="{StaticResource AquaInk}"/>
 </Style>
 <Style TargetType="DataGridColumnHeader">
  <Setter Property="Background" Value="{StaticResource AquaGlass}"/><Setter Property="Foreground" Value="{StaticResource AquaInk}"/>
  <Setter Property="Padding" Value="3,5"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="BorderBrush" Value="{StaticResource AquaEdge}"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
 </Style>
</ResourceDictionary>
